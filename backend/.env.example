# Reference for the environment variables the API reads. Export them in your
# shell, point Docker Compose at them, or put them in the process manager.
# The API does not read a .env file by itself.

# PostgreSQL (production / docker compose)
# DATABASE_URL=postgresql+psycopg://mclears:mclears@localhost:5432/mclears
# SQLite fallback used when DATABASE_URL is unset (development only)
# DATABASE_URL=sqlite:///./mclears.db

# Use a long random value in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# development | staging | production
APP_ENV=development

# Seed the demo accounts on an empty database
AUTO_SEED=true

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded documents are stored
STORAGE_DIR=./storage

# Serve the built React app from the API process. The compose stack sets this
# to false: the UI is served by the separate nginx container.
# SERVE_FRONTEND=false
# FRONTEND_DIR=./frontend/dist
